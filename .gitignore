# Sub-repositories (independent git repos cloned into workspace)
advanced-planning/
plannotator/
superpowers/

# Scratch test projects (intentionally isolated fresh repos)
scratch/

# Claude Code working state. Ignore everything, then re-admit the published skills one
# directory at a time. Never relax `.claude/skills/*` wholesale: this machine's local skill
# collection lives in the same tree and must not leak into the repository. Adding a skill to
# the product means adding one line here, deliberately.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/setup-with-claude/
!.claude/skills/gstack-to-plans/

# Local agent briefing (not public)
CLAUDE.md

# Internal working documents (superseded by public docs)
discovery-evaluation-report.md
META_REPO_LAUNCH.md
run-tests.sh

# Spec and plan files (development process, not public output)
docs/superpowers/

# The AAW installation manifest is generated per project by setup-with-claude and
# records absolute paths on the machine that wrote it. The schema and the example
# beside it ARE shipped; only the generated instance is ignored.
.aaw/installed.json

# Node/Bun
node_modules/
bun-*.zip

# Python
__pycache__/
*.pyc

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# Logs
*.log
